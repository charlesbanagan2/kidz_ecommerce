# Flask Configuration
SECRET_KEY=your-secret-key-here-change-in-production
FLASK_ENV=development
FLASK_DEBUG=1

# Database Configuration
# Option A: single URI (preferred)
DATABASE_URI=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?sslmode=require
# Optional alias used by app.py
SUPABASE_DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?sslmode=require
# Optional SSL mode override for PostgreSQL/Supabase
DB_SSLMODE=require
# Option B: parts (used if DATABASE_URI is empty)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DB=kids_ecommerce
MYSQL_USER=root
MYSQL_PASSWORD=

# Google OAuth Configuration
GOOGLE_OAUTH_CLIENT_ID=your-google-client-id
GOOGLE_OAUTH_CLIENT_SECRET=your-google-client-secret

# Email Configuration (for notifications)
MAIL_SENDER=your-email@gmail.com
MAIL_APP_PASSWORD=your-app-password

# EmailListVerify (real-time email validation)
# Get your API key from https://emaillistverify.com/ and set it here.
EMAILLISTVERIFY_API_KEY=

# PayMongo Configuration (Payment Gateway)
PAYMONGO_PUBLIC_KEY=pk_test_your_public_key_here
PAYMONGO_SECRET_KEY=sk_test_your_secret_key_here

# Upload Folder
UPLOAD_FOLDER=static/uploads
