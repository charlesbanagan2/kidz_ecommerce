# Flask Configuration
SECRET_KEY=dev-secret-key-change-in-production
FLASK_ENV=development
FLASK_DEBUG=1

# Database Configuration
# Option A: single URI (preferred)
DATABASE_URI=mysql+pymysql://root@127.0.0.1:3306/kids_ecommerce?charset=utf8mb4
# Option B: parts (used if DATABASE_URI is empty)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DB=kids_ecommerce
MYSQL_USER=root
MYSQL_PASSWORD=

# Google OAuth Configuration
GOOGLE_OAUTH_CLIENT_ID=your-google-client-id
GOOGLE_OAUTH_CLIENT_SECRET=your-google-client-secret

# Email Configuration (for notifications)
MAIL_SENDER=your-email@gmail.com
MAIL_APP_PASSWORD=your-app-password

# EmailListVerify (real-time email validation)
# Get your API key from https://emaillistverify.com/ and set it here.
# Leave empty to skip external validation and use basic validation only
EMAILLISTVERIFY_API_KEY=

# PayMongo Configuration (Payment Gateway)
PAYMONGO_PUBLIC_KEY=pk_test_your_public_key_here
PAYMONGO_SECRET_KEY=sk_test_your_secret_key_here

# Upload Folder
UPLOAD_FOLDER=static/uploads
